{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Appsolutely Free alternative",
  "description": "One free or open source alternative to one or more paid apps. Health data such as stars and commit dates is fetched automatically and must not be added here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name", "summary", "type", "license", "website", "replaces",
    "platforms", "install", "pros", "cons", "switching_difficulty", "last_verified"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 280,
      "description": "One or two original sentences: what it is and who it suits."
    },
    "type": { "enum": ["open-source", "source-available", "freeware"] },
    "license": {
      "type": "string",
      "minLength": 1,
      "description": "SPDX identifier such as MPL-2.0 or GPL-3.0-or-later. For freeware or custom terms, use LicenseRef-Freeware or LicenseRef-Custom."
    },
    "website": { "type": "string", "format": "uri", "pattern": "^https://" },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "url"],
      "properties": {
        "host": { "enum": ["github", "gitlab", "codeberg", "sourcehut"] },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "replaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "description": "Slugs of files in apps/."
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["windows", "macos", "linux", "web", "android", "ios", "self-hosted"] }
    },
    "install": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["installer", "package-manager", "docker", "hosted-web", "build-from-source"] }
    },
    "parity": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 100 },
      "description": "Score from 0 to 100 per replaced app. See CONTRIBUTING.md for how to calculate it."
    },
    "switching_difficulty": { "enum": ["easy", "moderate", "hard"] },
    "pros": {
      "type": "array", "minItems": 2, "maxItems": 6,
      "items": { "type": "string", "minLength": 3, "maxLength": 120 }
    },
    "cons": {
      "type": "array", "minItems": 2, "maxItems": 6,
      "items": { "type": "string", "minLength": 3, "maxLength": 120 }
    },
    "best_for": { "type": "string", "maxLength": 160 },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "telemetry": { "enum": ["none", "opt-in", "opt-out", "on-by-default", "unknown"] },
        "ads": { "type": "boolean" }
      }
    },
    "funding": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri", "pattern": "^https://" }
    },
    "maturity": {
      "enum": ["early", "established"],
      "description": "Use early when the project calls itself alpha or beta, or has not reached version 1.0."
    },
    "warnings": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "source"],
        "properties": {
          "text": { "type": "string", "minLength": 10, "maxLength": 200 },
          "source": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      },
      "description": "Known maintenance or security problems. Every warning must link to a source."
    },
    "claimed_by": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$" },
    "last_verified": { "type": "string", "format": "date" },
    "verified_by": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "enum": ["open-source", "source-available"] } },
        "required": ["type"]
      },
      "then": { "required": ["repo"] }
    }
  ]
}
